# Copy this file to .env and fill in your own values. Never commit .env.
# Do not add .env to Flutter assets: anything bundled in the app can be extracted.

# Google AI Studio key, used when LLM_PROVIDER=gemini. Paste only into your local .env.
GEMINI_API_KEY=
LLM_EXTRACT_MODEL=gemini-3.8-flash
LLM_EMBED_MODEL=gemini-embedding-001
LLM_DAILY_TOKEN_BUDGET=200000
